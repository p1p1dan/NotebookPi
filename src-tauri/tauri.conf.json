{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotebookPi",
  "version": "0.1.0",
  "identifier": "com.notebookpi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NotebookPi",
        "url": "index.html",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      },
      {
        "label": "quick-note",
        "title": "快速记录",
        "url": "quick-note.html",
        "width": 480,
        "height": 320,
        "minWidth": 360,
        "minHeight": 220,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "NotebookPi desktop client with offline cache",
    "longDescription": "Single-user notebook desktop app: offline-first SQLite cache, sync queue, quick-capture window."
  },
  "plugins": {}
}
