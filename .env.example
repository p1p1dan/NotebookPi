# Login password (required). The only credential for the single user.
NOTEBOOK_PASSWORD=changeme

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-long-random-string

# Optional: enables `Authorization: Bearer <token>` auth for scripts / AI.
# When set, any API endpoint accepts either the session cookie OR this token.
# Generate with the same command as SESSION_SECRET. Must be ≥16 chars.
# Leave empty to disable the Bearer path entirely.
#
# REQUIRED if you plan to use the Tauri desktop client — it authenticates
# exclusively via this token. Configure the same value in the desktop app's
# settings page after first launch.
API_TOKEN=

# Listen port (host-side). Container always listens on 8454 internally.
PORT=8454

# Set to "1" to mark cookies as Secure (only over HTTPS). Use behind a TLS proxy.
COOKIE_SECURE=0
