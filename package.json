{
  "name": "notebook-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-user online notebook (Markdown, folders, full-text search) + Tauri desktop shell",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev:server": "node --env-file-if-exists=.env --watch src/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "codemirror": "^6.0.1",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
